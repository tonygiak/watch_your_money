# Backend environment (ADR-0002 + ADR-0015 + AGENTS.md §5.6).
#
# Copy this file to `backend/.env` and fill in real values from the Supabase
# dashboard. NEVER commit `backend/.env` — it is git-ignored.

# Supabase project URL (Project Settings → API → Project URL).
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (Project Settings → API → service_role).
# Backend-only; the mobile client never sees this.
SUPABASE_SERVICE_KEY=...

# ---- Auth / JWT verification (ADR-0015) ------------------------------------
# The backend verifies the Supabase Auth Bearer JWT in-process using the
# project's JWKS (ES256 / RS256 — modern asymmetric posture). HS256 is
# retained as a transitional path while a project is rolled back to the
# legacy signing secret.

# JWKS endpoint. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# when unset. Override only for testing.
SUPABASE_JWKS_URL=

# In-process JWKS cache TTL (seconds). Default 600 per ADR-0015 §3.
SUPABASE_JWKS_CACHE_TTL_SECONDS=600

# Legacy HS256 signing secret (Project Settings → API → JWT Settings).
# Optional — required only while the project is on the Legacy HS256 key
# (Option A / DES-0006 rollback window). Leave blank once the project is
# fully on JWT Signing Keys (ES256 / RS256).
SUPABASE_JWT_LEGACY_HS256_SECRET=

# DEPRECATED — one-release alias for SUPABASE_JWT_LEGACY_HS256_SECRET.
# Setting both to different values fails the service at boot (ADR-0015 §5).
# Remove once the rename has propagated to all deployment environments.
SUPABASE_JWT_SECRET=

# Greek e-invoicing portal base URL. Override only for testing.
EINVOICING_BASE_URL=https://e-invoicing.gr
