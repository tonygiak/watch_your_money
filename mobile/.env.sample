# Disable Expo CLI telemetry by default (ADR-0007 §4 supply-chain condition).
EXPO_NO_TELEMETRY=1

# Supabase project (ADR-0002 + ADR-0004): used by `@supabase/supabase-js` for
# the OTP flow and the RLS-protected `/receipts` reads. The anon key is the
# only key that ever reaches the device; the service key is backend-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# FastAPI backend URL the scanner calls to parse receipts.
BACKEND_API_URL=http://localhost:8000
