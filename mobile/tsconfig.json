{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/lib/**/*",
    "src/i18n/**/*",
    "src/parsers/**/*",
    "src/screens/scanner/state.ts",
    "__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/screens/HomeScreen.tsx",
    "src/screens/ScannerScreen.tsx",
    "src/screens/scanner/ScannerScreen.tsx",
    "src/api/**/*",
    "src/navigation/**/*"
  ]
}
